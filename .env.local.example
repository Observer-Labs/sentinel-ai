# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The "From" address (must be verified in Resend)
FROM_EMAIL=Sentinel <alerts@yourdomain.com>

# ─── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# Setup steps:
# 1. Create a Meta Developer account: https://developers.facebook.com/
# 2. Create a Business App → Add WhatsApp product
# 3. Get your Phone Number ID from WhatsApp > Getting Started
# 4. Generate a permanent access token via System User in Meta Business Manager
# 5. Create a message template named "sentinel_alert" with 3 body params:
#    {{1}} = alert title, {{2}} = severity, {{3}} = description
#    Submit for approval at: https://business.facebook.com/wa/manage/message-templates/
META_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=your-permanent-access-token

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
